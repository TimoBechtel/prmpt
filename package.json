{
  "name": "prmt",
  "version": "1.0.0",
  "description": "Type-safe, composable string templating and formatting for llms.",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimoBechtel/prmpt"
  },
  "author": "Timo Bechtel",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "llm",
    "prompt",
    "template",
    "templating",
    "string",
    "text",
    "formatting"
  ],
  "scripts": {
    "prepack": "bun run build",
    "build": "zshy",
    "test": "bun test"
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@timobechtel/style": "^2.0.1",
    "@types/bun": "^1.3.9",
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "zshy": "^0.7.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
